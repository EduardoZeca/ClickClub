@model IReadOnlyList<PermissaoReservaDependenteApi>
@{
    ViewData["Title"] = "Permissões de dependentes";
}

<h1>Permissões de dependentes</h1>
<p>O titular pode autorizar um dependente menor de 18 anos a fazer futuras reservas pagas sem solicitar aprovação a cada reserva. A cobrança simulada continua vinculada à associação do titular. Reservas gratuitas não exigem autorização.</p>
<p>Revogar a permissão impede novas reservas pagas feitas por menores, mas não cancela reservas já confirmadas.</p>

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="alert alert-success">@sucesso</div>
}
@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger">@erro</div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Dependente</th><th>Nascimento</th><th>Precisa de autorização</th><th>Permissão para locações pagas</th><th>Ação</th></tr>
        </thead>
        <tbody>
        @foreach (var dependente in Model)
        {
            <tr>
                <td>@dependente.Nome</td>
                <td>@(dependente.DataNascimento?.ToString("dd/MM/yyyy") ?? "Não informada")</td>
                <td>@(dependente.PrecisaAutorizacao ? "Sim" : "Não (maior de idade)")</td>
                <td>@(dependente.PermitirReservaPaga ? "Concedida" : "Não concedida")</td>
                <td>
                    @if (dependente.PrecisaAutorizacao)
                    {
                        <form asp-action="AlterarPermissao" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="vinculoId" value="@dependente.VinculoId" />
                            <input type="hidden" name="permitirReservaPaga" value="@(dependente.PermitirReservaPaga ? "false" : "true")" />
                            <button class="btn btn-sm @(dependente.PermitirReservaPaga ? "btn-outline-danger" : "btn-outline-primary")" type="submit">
                                @(dependente.PermitirReservaPaga ? "Revogar" : "Autorizar")
                            </button>
                        </form>
                    }
                    else
                    {
                        <span>Não necessária</span>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="5">Nenhum dependente ativo encontrado nesta associação.</td></tr>
        }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-outline-secondary">Voltar às reservas</a>
