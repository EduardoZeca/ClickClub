@model IReadOnlyList<UnidadeApi>
@{
    ViewData["Title"] = "Clubes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Clubes / Unidades</h1>
    <a asp-action="Criar" class="btn btn-primary">Cadastrar clube</a>
</div>

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="alert alert-success" role="status">@sucesso</div>
}
@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger" role="alert">@erro</div>
}
@if (ViewBag.Erro is string erroConsulta)
{
    <div class="alert alert-danger" role="alert">@erroConsulta</div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Sigla</th>
                <th>Município / UF</th>
                <th>Situação</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var clube in Model)
            {
                var ativa = clube.Status == "Ativa";
                <tr>
                    <td>@clube.Nome</td>
                    <td>@(clube.Sigla ?? "—")</td>
                    <td>@clube.Municipio / @clube.Uf</td>
                    <td>@(ativa ? "Ativa" : "Inativa")</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="Editar" asp-route-id="@clube.Id"
                               class="btn btn-sm btn-outline-primary">Editar</a>
                            <form asp-action="AlterarSituacao" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@clube.Id" />
                                <input type="hidden" name="ativa" value="@(ativa ? "false" : "true")" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    @(ativa ? "Desativar" : "Reativar")
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="5">Nenhum clube encontrado.</td></tr>
            }
        </tbody>
    </table>
</div>
