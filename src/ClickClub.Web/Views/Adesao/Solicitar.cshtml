@model SolicitacaoAdesaoFormulario
@{
    ViewData["Title"] = "Solicitar adesão";
}

<h1>Solicitar adesão</h1>
<p>Solicitação para um clube. Apenas os vínculos Convidado e Simpatizante podem ser solicitados neste formulário. A adesão depende de aprovação.</p>

<form asp-action="Solicitar" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="col-md-6">
        <label asp-for="Nome" class="form-label">Nome completo</label>
        <input asp-for="Nome" class="form-control" autocomplete="name" />
    </div>
    <div class="col-md-3">
        <label asp-for="Cpf" class="form-label">CPF (apenas números)</label>
        <input asp-for="Cpf" class="form-control" inputmode="numeric" maxlength="11" />
    </div>
    <div class="col-md-3">
        <label asp-for="DataNascimento" class="form-label">Data de nascimento</label>
        <input asp-for="DataNascimento" type="date" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="UnidadePretendidaId" class="form-label">Clube pretendido</label>
        <select asp-for="UnidadePretendidaId" class="form-select">
            <option value="0">Selecione o clube</option>
            @foreach (var clube in Model.Clubes)
            {
                <option value="@clube.Id">@clube.Nome</option>
            }
        </select>
    </div>
    <div class="col-md-6">
        <label asp-for="TipoVinculoId" class="form-label">Tipo de vínculo</label>
        <select asp-for="TipoVinculoId" class="form-select">
            <option value="0">Selecione o vínculo</option>
            @foreach (var tipo in Model.TiposVinculo)
            {
                <option value="@tipo.Id">@tipo.Nome</option>
            }
        </select>
    </div>

    <div class="col-md-6">
        <label asp-for="Endereco" class="form-label">Endereço</label>
        <input asp-for="Endereco" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Bairro" class="form-label">Bairro</label>
        <input asp-for="Bairro" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Cidade" class="form-label">Cidade</label>
        <input asp-for="Cidade" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Uf" class="form-label">UF</label>
        <input asp-for="Uf" class="form-control" maxlength="2" />
    </div>
    <div class="col-md-3">
        <label asp-for="Sexo" class="form-label">Sexo</label>
        <input asp-for="Sexo" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="EstadoCivil" class="form-label">Estado civil</label>
        <input asp-for="EstadoCivil" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Telefone" class="form-label">Telefone</label>
        <input asp-for="Telefone" class="form-control" type="tel" autocomplete="tel" />
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label">E-mail</label>
        <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
    </div>
    <div class="col-md-6">
        <label asp-for="InteressesTexto" class="form-label">Interesses (separados por vírgula)</label>
        <input asp-for="InteressesTexto" class="form-control" placeholder="Pesca, churrasco, esportes" />
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary" disabled="@(Model.Clubes.Count == 0 || Model.TiposVinculo.Count == 0)">Enviar solicitação</button>
    </div>
</form>

<p class="mt-3"><a asp-action="Consultar">Já possui um código? Consulte sua solicitação.</a></p>
