@model EspacoFormulario
@{
    ViewData["Title"] = Model.Id == 0 ? "Cadastrar espaço" : "Editar espaço";
    var editando = Model.Id != 0;
    var nomeClube = Model.Clubes.FirstOrDefault(c => c.Id == Model.UnidadeId)?.Nome
        ?? $"Clube nº {Model.UnidadeId}";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Salvar" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="col-md-6">
        <label asp-for="UnidadeId" class="form-label">Clube</label>
        @if (editando)
        {
            <input asp-for="UnidadeId" type="hidden" />
            <input type="text" class="form-control" readonly
                   value="@nomeClube" />
            <div class="form-text">Para mudar de clube, desative este espaço e cadastre outro.</div>
        }
        else
        {
            <select asp-for="UnidadeId" class="form-select">
                <option value="0">Selecione o clube</option>
                @foreach (var clube in Model.Clubes)
                {
                    <option value="@clube.Id">@clube.Nome</option>
                }
            </select>
        }
    </div>

    <div class="col-md-6">
        <label asp-for="Nome" class="form-label">Nome do espaço</label>
        <input asp-for="Nome" class="form-control" maxlength="150" />
    </div>
    <div class="col-md-4">
        <label asp-for="Tipo" class="form-label">Tipo</label>
        <select asp-for="Tipo" class="form-select">
            <option value="">Selecione</option>
            <option value="SalaoFestas">Salão de Festas</option>
            <option value="Churrasqueira">Churrasqueira</option>
            <option value="Quadra">Quadra</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="Capacidade" class="form-label">Capacidade (pessoas)</label>
        <input asp-for="Capacidade" type="number" min="1" max="10000" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="TaxaBase" class="form-label">Taxa base (R$)</label>
        <input asp-for="TaxaBase" type="number" min="0" step="0.01" class="form-control" />
        <div class="form-text">Valor fictício ou configurável. Use 0 para espaço gratuito.</div>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Salvar espaço</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
