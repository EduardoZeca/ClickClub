@model IReadOnlyList<CategoriaApi>
@{
    ViewData["Title"] = "Categorias associativas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Categorias associativas</h1>
    <a asp-action="Criar" class="btn btn-primary">Cadastrar categoria</a>
</div>

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="alert alert-success" role="status">@sucesso</div>
}
@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger" role="alert">@erro</div>
}
@if (ViewBag.Erro is string erroConsulta)
{
    <div class="alert alert-danger" role="alert">@erroConsulta</div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Categoria</th><th>Situação</th><th>Ações</th></tr>
        </thead>
        <tbody>
            @foreach (var categoria in Model)
            {
                <tr>
                    <td>@categoria.Nome</td>
                    <td>@(categoria.Ativa ? "Ativa" : "Inativa")</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="Editar" asp-route-id="@categoria.Id"
                               class="btn btn-sm btn-outline-primary">Editar</a>
                            <form asp-action="AlterarSituacao" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@categoria.Id" />
                                <input type="hidden" name="ativa"
                                       value="@(categoria.Ativa ? "false" : "true")" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    @(categoria.Ativa ? "Desativar" : "Reativar")
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="3">Nenhuma categoria encontrada.</td></tr>
            }
        </tbody>
    </table>
</div>
