@model CategoriaFormulario
@{
    ViewData["Title"] = Model.Id > 0 ? "Editar categoria" : "Cadastrar categoria";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form asp-controller="Categorias" asp-action="Salvar" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6">
        <label asp-for="Nome" class="form-label">Nome da categoria</label>
        <input asp-for="Nome" class="form-control" maxlength="100" />
        <span asp-validation-for="Nome" class="text-danger"></span>
        <div class="form-text">Exemplos: Familiar, Individual ou Atleta.</div>
    </div>
    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
