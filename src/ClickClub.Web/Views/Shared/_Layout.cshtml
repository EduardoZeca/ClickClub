<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClickClub</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClickClub.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ClickClub</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Adesao" asp-action="Solicitar">Solicitar adesão</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Adesao" asp-action="Consultar">Consultar adesão</a>
                        </li>
                        @if (User.IsInRole("AdministradorGeral"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Unidades" asp-action="Index">Clubes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Categorias" asp-action="Index">Categorias</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Titulares" asp-action="Index">Titulares</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Equipe" asp-action="Index">Equipe</a>
                            </li>
                        }
                        @if (User.IsInRole("AdministradorGeral") ||
                             User.IsInRole("FuncionarioUnidade") ||
                             User.IsInRole("Porteiro") ||
                             User.IsInRole("PresidenteClube") ||
                             User.IsInRole("Tesoureiro"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="MeusClubes" asp-action="Index">Meus clubes</a>
                            </li>
                        }
                        @if (User.IsInRole("AdministradorGeral") || User.IsInRole("PresidenteClube"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Solicitacoes" asp-action="Index">Solicitações</a>
                            </li>
                        }
                        @if (User.IsInRole("AdministradorGeral") ||
                             User.IsInRole("FuncionarioUnidade") ||
                             User.IsInRole("PresidenteClube"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Espacos" asp-action="Index">Espaços</a>
                            </li>
                        }
                        @if (User.IsInRole("Titular") || User.IsInRole("Dependente"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="MinhaAssociacao" asp-action="Index">Minha associação</a>
                            </li>
                        }
                        @if (User.IsInRole("Titular") || User.IsInRole("Dependente"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Reservas" asp-action="Index">Reservas</a>
                            </li>
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="navbar-text me-3">@User.Identity.Name</span>
                        <form asp-controller="Conta" asp-action="Sair" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Sair</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Conta" asp-action="Entrar" class="btn btn-outline-primary btn-sm">Entrar</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ClickClub
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
