@model IReadOnlyList<EventoSocialApi>
@{
    ViewData["Title"] = "Gerenciar eventos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Gerenciar eventos</h1>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Eventos publicados</a>
        <a asp-action="Criar" class="btn btn-primary">Novo evento</a>
    </div>
</div>
@if (TempData["Sucesso"] is string sucesso)
{
    <div class="alert alert-success">@sucesso</div>
}
@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger">@erro</div>
}
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Clube</th><th>Evento</th><th>Período local</th><th>Público</th><th>Ocupação</th><th>Situação</th><th>Ações</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Clube</td>
                <td>@item.Nome<div class="small text-muted">@item.Tipo</div></td>
                <td>@item.InicioLocal.ToString("dd/MM/yyyy HH:mm") a @item.FimLocal.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(item.PublicoAlvo == "PublicoGeral" ? "Público geral" : "Associados")</td>
                <td>@item.Inscritos @(item.Capacidade.HasValue ? $"/ {item.Capacidade}" : "/ sem limite")</td>
                <td>@item.Status</td>
                <td>
                    <div class="d-flex flex-wrap gap-1">
                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Inscritos" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Inscritos</a>
                        @if (item.PublicoAlvo == "PublicoGeral")
                        {
                            <a asp-action="Visitantes" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Visitantes</a>
                        }
                        @if (item.Status == "Publicado")
                        {
                            <form asp-action="AlterarSituacao" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="status" value="Encerrado" />
                                <button class="btn btn-sm btn-outline-secondary">Encerrar</button>
                            </form>
                            <form asp-action="AlterarSituacao" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="status" value="Cancelado" />
                                <button class="btn btn-sm btn-outline-danger">Cancelar</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="AlterarSituacao" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="status" value="Publicado" />
                                <button class="btn btn-sm btn-outline-primary">Republicar</button>
                            </form>
                        }
                    </div>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7">Nenhum evento nas unidades sob sua gestão.</td></tr>
        }
        </tbody>
    </table>
</div>
