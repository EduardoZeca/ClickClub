@model EventoFormulario
@{
    ViewData["Title"] = Model.Id == 0 ? "Cadastrar evento" : "Editar evento";
    var clubeAtual = Model.Clubes.FirstOrDefault(c => c.Id == Model.UnidadeId)?.Nome
        ?? $"Clube nº {Model.UnidadeId}";
}

<h1 class="h3">@ViewData["Title"]</h1>
<form asp-action="Salvar" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="col-md-6">
        <label asp-for="UnidadeId" class="form-label">Clube</label>
        @if (Model.Id != 0)
        {
            <input asp-for="UnidadeId" type="hidden" />
            <input type="text" value="@clubeAtual" readonly class="form-control" />
        }
        else
        {
            <select asp-for="UnidadeId" class="form-select">
                <option value="0">Selecione o clube</option>
                @foreach (var clube in Model.Clubes)
                {
                    <option value="@clube.Id">@clube.Nome (@clube.FusoHorario)</option>
                }
            </select>
        }
    </div>
    <div class="col-md-6">
        <label asp-for="Nome" class="form-label">Nome do evento</label>
        <input asp-for="Nome" maxlength="150" class="form-control" required />
    </div>
    <div class="col-md-4">
        <label asp-for="Tipo" class="form-label">Tipo</label>
        <select asp-for="Tipo" class="form-select">
            <option value="Social">Social</option>
            <option value="Torneio">Torneio simples (inscrição e vagas)</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="PublicoAlvo" class="form-label">Público-alvo</label>
        <select asp-for="PublicoAlvo" class="form-select">
            <option value="SomenteAssociados">Somente associados</option>
            <option value="PublicoGeral">Público geral</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="Capacidade" class="form-label">Limite de participantes</label>
        <input asp-for="Capacidade" type="number" min="1" max="10000" class="form-control" />
        <div class="form-text">Obrigatório para torneio; vazio = divulgação sem inscrições de associados.</div>
    </div>
    <div class="col-md-6">
        <label asp-for="InicioLocal" class="form-label">Início (horário local do clube)</label>
        <input asp-for="InicioLocal" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" required />
    </div>
    <div class="col-md-6">
        <label asp-for="FimLocal" class="form-label">Fim (horário local do clube)</label>
        <input asp-for="FimLocal" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" required />
    </div>
    <div class="col-12">
        <label asp-for="Descricao" class="form-label">Descrição</label>
        <textarea asp-for="Descricao" maxlength="2000" rows="3" class="form-control"></textarea>
    </div>
    <div class="col-12 small text-muted">Evento público não autoriza acesso por si só. Visitantes precisam ser cadastrados e validados online pela portaria.</div>
    <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary" type="submit">Salvar evento</button>
        <a asp-action="Gerenciar" class="btn btn-outline-secondary">Voltar</a>
    </div>
</form>
