@model IReadOnlyList<FaturaResumoApi>
@{
    ViewData["Title"] = "Faturas";
    var administrador = User.IsInRole("AdministradorGeral");
    var tesoureiro = User.IsInRole("Tesoureiro");
    var culturaMoeda = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
}

<div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3">
    <h1 class="h3 mb-0">@(administrador ? "Faturas da organização" : tesoureiro ? "Faturas dos meus clubes" : "Minhas mensalidades")</h1>
    @if (administrador)
    {
        <div class="d-flex gap-2">
            <a asp-action="Politicas" class="btn btn-outline-primary">Valores mensais</a>
            <a asp-action="Emitir" class="btn btn-primary">Emitir mensalidade</a>
        </div>
    }
    @if (administrador || tesoureiro)
    {
        <a asp-action="Locacoes" class="btn btn-outline-primary">Locações dos clubes prestadores</a>
    }
</div>

<p class="text-muted">Operações financeiras exclusivamente simuladas. Faturas pertencem ao clube de origem da associação; locações podem ser prestadas por outros clubes. Somente a administração geral cadastra políticas e emite mensalidades.</p>

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="alert alert-success" role="status">@sucesso</div>
}
@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger" role="alert">@erro</div>
}
@if (ViewBag.Erro is string erroConsulta)
{
    <div class="alert alert-danger" role="alert">@erroConsulta</div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Competência</th>
                <th>Associação</th>
                <th>Clube de origem</th>
                <th>Vencimento</th>
                <th>Valor</th>
                <th>Situação</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fatura in Model)
            {
                <tr>
                    <td>@fatura.Competencia.ToString("MM/yyyy")</td>
                    <td>@fatura.Matricula — @fatura.Titular</td>
                    <td>@fatura.Clube</td>
                    <td>@fatura.DataVencimento.ToString("dd/MM/yyyy")</td>
                    <td>
                        @fatura.TotalAtualizado.ToString("C", culturaMoeda)
                        @if (fatura.MultaPendente > 0)
                        {
                            <small class="d-block text-muted">Inclui multa prevista de @fatura.MultaPendente.ToString("C", culturaMoeda)</small>
                        }
                    </td>
                    <td>
                        @(fatura.Status == "EmPreparacao" ? "Em preparação" : fatura.Status == "EmAberto" ? (fatura.BloqueioPorAtraso ? "Em atraso — bloqueio de novas reservas" : "Em aberto") : fatura.Status == "QuitadaSimulada" ? "Quitada (simulada)" : "Cancelada")
                    </td>
                    <td><a asp-action="Detalhes" asp-route-id="@fatura.Id" class="btn btn-sm btn-outline-primary">Detalhes</a></td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="7">Nenhuma fatura encontrada.</td></tr>
            }
        </tbody>
    </table>
</div>
