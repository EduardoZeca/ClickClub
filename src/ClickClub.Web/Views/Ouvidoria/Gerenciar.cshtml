@model IReadOnlyList<ChamadoOuvidoriaApi>
@{
    ViewData["Title"] = "Gerenciar ouvidoria";
}

<h1 class="h3 mb-3">Gerenciar ouvidoria</h1>
@if (TempData["Sucesso"] is string sucesso)
{
    <div class="alert alert-success">@sucesso</div>
}
@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger">@erro</div>
}
<p class="text-muted">São exibidos somente os chamados dos clubes sob sua responsabilidade. A ouvidoria geral fica restrita ao Administrador Geral.</p>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>ID</th><th>Clube</th><th>Solicitante</th><th>Tipo</th><th>Assunto</th><th>Situação</th><th>Ação</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>#@item.Id<div class="small text-muted">@item.CriadoEmUtc.ToString("dd/MM/yyyy HH:mm") UTC</div></td>
                <td>@(item.UnidadeId.HasValue ? item.Clube : "Geral")</td>
                <td>@item.Solicitante</td>
                <td>@(item.Tipo == "Reclamacao" ? "Reclamação" : "Solicitação")</td>
                <td>@item.Assunto</td>
                <td>@item.Status</td>
                <td><a asp-action="Detalhes" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Abrir</a></td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7">Nenhum chamado no seu escopo de gestão.</td></tr>
        }
        </tbody>
    </table>
</div>
