@model AdesaoDetalhesPagina
@{
    ViewData["Title"] = "Analisar adesão";
}

<h1>Solicitação nº @Model.Solicitacao.Id</h1>
<a asp-action="Index">Voltar às solicitações</a>

@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger mt-3">@erro</div>
}

<dl class="row mt-3">
    <dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@Model.Solicitacao.Nome</dd>
    <dt class="col-sm-3">CPF</dt><dd class="col-sm-9">@Model.Solicitacao.Cpf</dd>
    <dt class="col-sm-3">Contato</dt><dd class="col-sm-9">@Model.Solicitacao.Email / @Model.Solicitacao.Telefone</dd>
    <dt class="col-sm-3">Clube</dt><dd class="col-sm-9">@Model.Solicitacao.Clube</dd>
    <dt class="col-sm-3">Vínculo solicitado</dt><dd class="col-sm-9">@Model.Solicitacao.TipoVinculo</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Solicitacao.Status</dd>
    <dt class="col-sm-3">Enviada (UTC)</dt><dd class="col-sm-9">@Model.Solicitacao.SolicitadaEmUtc.ToString("dd/MM/yyyy HH:mm")</dd>
    @if (!string.IsNullOrWhiteSpace(Model.Solicitacao.Motivo))
    {
        <dt class="col-sm-3">Motivo registrado</dt><dd class="col-sm-9">@Model.Solicitacao.Motivo</dd>
    }
</dl>

@if (Model.Solicitacao.Status == "Pendente")
{
    <hr />
    <h2 class="h4">Decisão</h2>
    <form asp-action="Decidir" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Solicitacao.Id" />
        <div class="col-md-5">
            <label class="form-label" for="CategoriaId">Categoria associativa (para aprovar)</label>
            <select name="CategoriaId" id="CategoriaId" class="form-select">
                <option value="">Selecione a categoria</option>
                @foreach (var item in Model.Categorias)
                {
                    <option value="@item.Id">@item.Nome</option>
                }
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label" for="Matricula">Matrícula única (para aprovar)</label>
            <input name="Matricula" id="Matricula" class="form-control" maxlength="30" />
        </div>
        <div class="col-12">
            <label class="form-label" for="Motivo">Motivo (obrigatório se rejeitar)</label>
            <textarea name="Motivo" id="Motivo" class="form-control" rows="2" maxlength="500"></textarea>
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" name="Aprovar" value="true" class="btn btn-success">Aprovar e criar associação</button>
            <button type="submit" name="Aprovar" value="false" class="btn btn-outline-danger">Rejeitar</button>
        </div>
    </form>
}
else
{
    <div class="alert alert-info">Solicitação já analisada. Não é possível decidir novamente.</div>
}
