<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClickClub.Mobile.Paginas.MuralPage"
             Title="Mural de avisos" BackgroundColor="#F4F7FB">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="15">
            <Label Text="Mural de avisos" FontSize="26" FontAttributes="Bold" TextColor="#153559" />
            <Label Text="Avisos gerais e dos clubes. A consulta requer conexão com a API."
                   TextColor="#536477" />
            <Button x:Name="Atualizar" Text="Atualizar avisos" Clicked="AoAtualizar" />
            <ActivityIndicator x:Name="Indicador" IsVisible="False" IsRunning="False" />
            <Label x:Name="Mensagem" TextColor="#536477" />
            <VerticalStackLayout x:Name="Lista" Spacing="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
