<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClickClub.Mobile.Paginas.EspacosPage"
             Title="Espaços" BackgroundColor="#F4F7FB">
    <ScrollView>
        <VerticalStackLayout Padding="22,24" Spacing="12">
            <Label x:Name="NomeClube" FontSize="26" FontAttributes="Bold" TextColor="#153559" />
            <Label Text="O horário escolhido será conferido pela API. A listagem não garante disponibilidade no momento da confirmação." TextColor="#536477" />
            <Button x:Name="BotaoAtualizar" Text="Atualizar espaços" Clicked="AoAtualizar" />
            <ActivityIndicator x:Name="Indicador" IsRunning="False" IsVisible="False" Color="#153559" />
            <Label x:Name="Mensagem" TextColor="#536477" />
            <VerticalStackLayout x:Name="ListaEspacos" Spacing="10" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
