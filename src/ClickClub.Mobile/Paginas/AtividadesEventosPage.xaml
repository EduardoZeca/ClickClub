<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClickClub.Mobile.Paginas.AtividadesEventosPage"
             Title="Atividades e eventos" BackgroundColor="#F4F7FB">
    <ScrollView>
        <VerticalStackLayout Padding="22,24" Spacing="12">
            <Label Text="Atividades e eventos" FontSize="26" FontAttributes="Bold" TextColor="#153559" />
            <Label Text="Inscrições e vagas são confirmadas na API. Turmas lotadas podem gerar lista de espera."
                   TextColor="#536477" />
            <Picker x:Name="Tipo" Title="Selecione o catálogo" SelectedIndexChanged="AoTrocarTipo">
                <Picker.Items>
                    <x:String>Turmas esportivas</x:String>
                    <x:String>Eventos sociais</x:String>
                </Picker.Items>
            </Picker>
            <Button x:Name="Atualizar" Text="Atualizar catálogo" Clicked="AoAtualizar" />
            <Button Text="Minhas inscrições" BackgroundColor="#596779" Clicked="AoMinhas" />
            <ActivityIndicator x:Name="Indicador" Color="#153559" IsVisible="False" IsRunning="False" />
            <Label x:Name="Mensagem" TextColor="#536477" />
            <VerticalStackLayout x:Name="Lista" Spacing="10" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
