<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClickClub.Mobile.Paginas.FinanceiroPage"
             Title="Financeiro" BackgroundColor="#F4F7FB">
    <ScrollView>
        <VerticalStackLayout Padding="22,24" Spacing="12">
            <Label Text="Minhas mensalidades" FontSize="25" FontAttributes="Bold" TextColor="#153559" />
            <Label Text="Valores exclusivamente simulados. Consulta disponível somente para contas autorizadas pela API."
                   TextColor="#536477" />
            <Button x:Name="Atualizar" Text="Atualizar faturas" Clicked="AoAtualizar" />
            <ActivityIndicator x:Name="Indicador" Color="#153559" IsVisible="False" IsRunning="False" />
            <Label x:Name="Mensagem" TextColor="#536477" />
            <VerticalStackLayout x:Name="Lista" Spacing="10" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
