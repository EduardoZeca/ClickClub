<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClickClub.Mobile.Paginas.OuvidoriaPage"
             Title="Ouvidoria" BackgroundColor="#F4F7FB">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="14">
            <Label Text="Ouvidoria" FontSize="26" FontAttributes="Bold" TextColor="#153559" />
            <Label Text="Acompanhe suas solicitações e reclamações." TextColor="#536477" />
            <Button Text="Abrir novo chamado" Clicked="AoCriar" />
            <Button x:Name="Atualizar" Text="Atualizar meus chamados" Clicked="AoAtualizar" />
            <ActivityIndicator x:Name="Indicador" IsVisible="False" IsRunning="False" />
            <Label x:Name="Mensagem" TextColor="#536477" />
            <VerticalStackLayout x:Name="Lista" Spacing="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
